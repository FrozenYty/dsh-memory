{
  "name": "dsh-memory",
  "version": "0.23.8",
  "private": true,
  "description": "Your experience, visible to the agent — a markdown memory notebook for DeepSeek Harness. Every entry carries the evidence that proves it, every index line says what it is about, and the agent reads on purpose.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrozenYty/dsh-memory.git"
  },
  "bugs": {
    "url": "https://github.com/FrozenYty/dsh-memory/issues"
  },
  "homepage": "https://github.com/FrozenYty/dsh-memory#readme",
  "scripts": {
    "test": "node tests/core.test.mjs"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "notebook-core.js",
    "cordis.patch.yml",
    "README.md",
    "templates/*.md",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "memory"
  ]
}
